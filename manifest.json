{
  "manifest_version": 3,
  "name": "Calculadora Livre",
  "version": "1.16.0",
  "minimum_chrome_version": "111",
  "description": "Precificação, auditoria de margem e inteligência competitiva para vendedores do Mercado Livre e Shopee.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.mercadolivre.com.br/*",
    "*://*.shopee.com.br/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Configurações da Calculadora Livre",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.mercadolivre.com.br/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.mercadolivre.com.br/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["*://*.shopee.com.br/*"],
      "css": ["shopee.css"],
      "js": ["shopee.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
